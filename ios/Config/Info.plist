<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Keys Xcode cannot generate from INFOPLIST_KEY_ settings. Merged with the generated Info.plist.
  The Google scheme comes from PGYM_GOOGLE_REVERSED_CLIENT_ID in Config/PGYM.xcconfig.
  NSAllowsLocalNetworking lets the simulator PUT to MinIO and call the emulator over plain HTTP on the
  local network (card I7). It does not loosen App Transport Security for any internet host.
  UILaunchScreen (card I9): the PGYM mark on Ink, the same mark and size as the launch view in
  AppRootView.swift, so launch hands over to the app without a flash. Assets: LaunchBackground, LaunchMark.
-->
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PGYM_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
