{
  "name": "pgym-backend",
  "private": true,
  "version": "0.1.0",
  "description": "PGYM Cloud Functions and Firestore rules",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "firebase emulators:exec --only firestore,auth --project pgym-local \"vitest run\"",
    "test:unit": "vitest run test/streak.test.ts test/s3PhotoStore.test.ts",
    "emulators": "firebase emulators:start --only firestore,auth,functions --project pgym-local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.15.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.25.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
